# ── Required ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/trendwise
PORT=5000

# Shared JWT signing key. MUST match what the frontend expects and MUST be set
# in production — signing and verifying both read this one value via
# src/config/env.ts.
JWT_SECRET=change-me-to-a-long-random-string

# Mongo _id of the admin user. isAdmin compares the verified token's userId
# against this; if it is unset every /api/admin request returns 500.
ADMIN_USER_ID=

# Comma-separated list of emails that get role=admin on first sign-in.
ADMIN_EMAILS=you@example.com

# ── Article generation ──────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash-001
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Trend sourcing ──────────────────────────────────────────────────────────
GNEWS_API_KEY=
NEWSAPI_KEY=

# Free tiers allow ~100 (GNews) / ~500 (NewsAPI) requests per DAY. The scan
# issues one request per country x category, so keep this product small.
# Defaults: 3 countries x 3 categories = 9 requests per run.
TRENDS_COUNTRIES=us,gb,in
TRENDS_CATEGORIES=general,technology,business
TRENDS_MAX_PER_QUERY=3
TRENDS_MAX_RESULTS=40
TRENDS_REQUEST_GAP_MS=1200

# ── Retention / DB resilience ───────────────────────────────────────────────
# Articles older than this are purged by the 01:00 cron job.
ARTICLE_RETENTION_DAYS=7

DB_CONNECT_ATTEMPTS=5
DB_CONNECT_RETRY_MS=3000
DB_SERVER_SELECTION_TIMEOUT_MS=10000
