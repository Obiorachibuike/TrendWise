# ── Required ────────────────────────────────────────────────────────────────
# Public origin of the Express API. Inlined into the client bundle at BUILD
# time, so it must be set before `next build` runs. Every call goes through
# app/lib/api.ts, which prefixes /api — set this to the bare origin, e.g.
# https://trendwise-api.onrender.com   (no trailing slash, no /api)
NEXT_PUBLIC_BASE_URL=

# Same origin, read server-side by the NextAuth callbacks. Falls back to
# NEXT_PUBLIC_BASE_URL if unset.
BACKEND_URL=

# ── NextAuth ────────────────────────────────────────────────────────────────
# The public URL of THIS Next.js app (e.g. https://trendwise.vercel.app).
# This is NOT the API origin — pointing it at the API was what broke login.
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Only providers with BOTH values set are registered; the login page shows a
# button only for those.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional providers ──────────────────────────────────────────────────────
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Contact form ────────────────────────────────────────────────────────────
# Lazily initialised: if unset, only POST /api/contact fails (500) rather than
# failing the whole build.
RESEND_API_KEY=
CONTACT_INBOX=obiorachibuike22@gmail.com

# ── SEO / client-side gates ─────────────────────────────────────────────────
# Site origin used by robots.txt, sitemap.xml and the metadata tags.
NEXT_PUBLIC_SITE_URL=

# Email allowed to see the admin dashboard. This is a UI gate only — the real
# check is the backend's isAdmin middleware against ADMIN_USER_ID.
NEXT_PUBLIC_ADMIN_EMAIL=
